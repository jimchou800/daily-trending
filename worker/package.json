{
  "name": "daily-trending-authority",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "coverage": "vitest run --coverage && vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test *.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format && npm run coverage"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.70",
    "@cloudflare/workers-types": "4.20250917.0",
    "@eslint/js": "9.35.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/node": "22.18.6",
    "@vitest/coverage-istanbul": "3.2.4",
    "eslint": "9.35.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4",
    "wrangler": "4.38.0"
  }
}
